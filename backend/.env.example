# Copier ce fichier en .env (jamais commité) et adapter les valeurs.
# Aucune valeur réelle ne doit figurer dans ce fichier d'exemple.

# Module de paramètres : config.settings.dev (local) ou config.settings.prod (o2switch).
# En local, manage.py utilise dev par défaut ; passenger_wsgi.py force prod.
# DJANGO_SETTINGS_MODULE=config.settings.dev

# Obligatoire en production. Générer une clé avec :
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# Hôtes autorisés, séparés par des virgules (ex. api.exemple.com).
DJANGO_ALLOWED_HOSTS=

# Base de données. Vide en local = SQLite (backend/db.sqlite3).
# Production : mysql://utilisateur:motdepasse@localhost:3306/nom_base
DATABASE_URL=

# Base utilisée uniquement par pytest (vide = SQLite en mémoire).
# TEST_DATABASE_URL=mysql://utilisateur:motdepasse@localhost:3306/nom_base_test

# Origines autorisées (CORS) et origines de confiance (CSRF), séparées par des virgules.
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=

# Emplacements des fichiers statiques et téléversés (facultatif).
# DJANGO_STATIC_ROOT=
# DJANGO_MEDIA_ROOT=

# Production uniquement.
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SECURE_HSTS_SECONDS=3600
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
# DJANGO_BEHIND_PROXY=False

# DJANGO_LOG_LEVEL=INFO
